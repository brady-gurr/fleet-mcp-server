# Named secrets YOU make up: what each person's Claude connector presents to this server.
# Format: name:secret, comma-separated for more than one person.
# Generate each secret with: openssl rand -hex 32
MCP_SHARED_SECRETS=

# Coast fuel cards (read-only use). Create the key in the Coast portal: Integrations -> API keys.
COAST_API_KEY=
# COAST_BASE_URL=https://public.coastpay.com        (sandbox: https://public.demo.coastpay.com)

# Fleetio / Ford Pro (read-only use). Create the key on the API keys page of your Fleetio instance.
FLEETIO_API_KEY=
FLEETIO_ACCOUNT_TOKEN=
# FLEETIO_BASE_URL=https://fleetio.fordpro.com/api
# FLEETIO_ACCOUNT_TOKEN_HEADER=Account-Token

# PORT=3000
